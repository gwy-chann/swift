generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff
  cashier
  mechanic

  @@map("user_role")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id        String    @id @db.Uuid
  email     String    @unique
  fullName  String?   @map("full_name")
  role      UserRole  @default(staff)
  status    String    @default("Active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Product {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku          String   @unique
  name         String
  category     String
  brand        String
  model        String   @default("Universal")
  cost         Decimal  @db.Decimal(10, 2)
  wholesale    Decimal  @db.Decimal(10, 2)
  retail       Decimal  @db.Decimal(10, 2)
  stock        Int      @default(0)
  minThreshold Int      @default(0) @map("min_threshold")
  location     String?
  oem          Boolean  @default(false)
  imageUrl     String?  @map("image_url")
  description  String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  stockAdjustments StockAdjustmentLog[]

  @@index([sku])
  @@index([category])
  @@index([brand])
  @@index([model])
  @@index([location])
  @@map("products")
}

model StockAdjustmentLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku            String
  adjustmentType String    @map("adjustment_type")
  quantityDelta  Int       @map("quantity_delta")
  previousStock  Int       @map("previous_stock")
  newStock       Int       @map("new_stock")
  reason         String    @default("")
  userId         String?   @map("user_id") @db.Uuid
  userName       String    @default("Staff Member") @map("user_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product        Product   @relation(fields: [sku], references: [sku], onDelete: Restrict, onUpdate: Cascade)

  @@index([sku])
  @@index([createdAt])
  @@index([userId])
  @@map("stock_adjustment_logs")
}

