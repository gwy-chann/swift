generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff
  cashier
  mechanic

  @@map("user_role")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id        String    @id @db.Uuid
  email     String    @unique
  fullName  String?   @map("full_name")
  role      UserRole  @default(staff)
  status    String    @default("Active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Product {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku          String   @unique
  name         String
  category     String
  brand        String
  model        String   @default("Universal")
  cost         Decimal  @db.Decimal(10, 2)
  wholesale    Decimal  @db.Decimal(10, 2)
  retail       Decimal  @db.Decimal(10, 2)
  stock        Int      @default(0)
  minThreshold Int      @default(0) @map("min_threshold")
  location     String?
  oem          Boolean  @default(false)
  imageUrl     String?  @map("image_url")
  description  String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  stockAdjustments StockAdjustmentLog[]
  fitments         ProductFitment[]

  @@index([sku])
  @@index([category])
  @@index([brand])
  @@index([model])
  @@index([location])
  @@map("products")
}

model StockAdjustmentLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku            String
  adjustmentType String    @map("adjustment_type")
  quantityDelta  Int       @map("quantity_delta")
  previousStock  Int       @map("previous_stock")
  newStock       Int       @map("new_stock")
  reason         String    @default("")
  userId         String?   @map("user_id") @db.Uuid
  userName       String    @default("Staff Member") @map("user_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product        Product   @relation(fields: [sku], references: [sku], onDelete: Restrict, onUpdate: Cascade)

  @@index([sku])
  @@index([createdAt])
  @@index([userId])
  @@map("stock_adjustment_logs")
}

model LaborService {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  bay         String
  rate        Decimal  @db.Decimal(10, 2)
  duration    String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rateAuditLogs ServiceRateAuditLog[]

  @@index([code])
  @@index([active])
  @@map("labor_services")
}

model ServiceRateAuditLog {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId   String       @map("service_id") @db.Uuid
  serviceCode String       @map("service_code")
  oldRate     Decimal      @map("old_rate") @db.Decimal(10, 2)
  newRate     Decimal      @map("new_rate") @db.Decimal(10, 2)
  reason      String       @default("")
  userName    String       @default("Admin Manager") @map("user_name")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  service     LaborService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([createdAt])
  @@map("service_rate_audit_logs")
}

model Transaction {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNumber  String            @unique @map("receipt_number")
  cashierId      String?           @map("cashier_id") @db.Uuid
  cashierName    String            @map("cashier_name")
  pricingMode    String            @map("pricing_mode")
  subtotal       Decimal           @db.Decimal(10, 2)
  discountType   String?           @map("discount_type")
  discountRate   Decimal           @default(0.0000) @map("discount_rate") @db.Decimal(5, 4)
  discountAmount Decimal           @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalDue       Decimal           @map("total_due") @db.Decimal(10, 2)
  cashTendered   Decimal           @map("cash_tendered") @db.Decimal(10, 2)
  changeDue      Decimal           @default(0.00) @map("change_due") @db.Decimal(10, 2)
  paymentMethod  String            @default("Cash") @map("payment_method")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  items          TransactionItem[]

  @@index([receiptNumber])
  @@index([createdAt])
  @@index([cashierId])
  @@index([pricingMode])
  @@index([paymentMethod])
  @@map("transactions")
}

model TransactionItem {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId   String      @map("transaction_id") @db.Uuid
  itemType        String      @map("item_type")
  itemSkuOrCode   String      @map("item_sku_or_code")
  itemName        String      @map("item_name")
  unitPrice       Decimal     @map("unit_price") @db.Decimal(10, 2)
  quantity        Int
  subtotal        Decimal     @db.Decimal(10, 2)
  bay             String?
  shelfLocation   String?     @map("shelf_location")

  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([itemType])
  @@index([itemSkuOrCode])
  @@map("transaction_items")
}

model PricingRules {
  id                Int      @id @default(1)
  retailMarkup      Decimal  @map("retail_markup") @db.Decimal(5, 2)
  wholesaleMarkup   Decimal  @map("wholesale_markup") @db.Decimal(5, 2)
  aftermarketMarkup Decimal  @map("aftermarket_markup") @db.Decimal(5, 2)
  hourlyLaborRate   Decimal  @map("hourly_labor_rate") @db.Decimal(10, 2)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?  @map("updated_by") @db.Uuid

  @@map("pricing_rules")
}

model PricingRulesAuditLog {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  changedBy            String?  @map("changed_by") @db.Uuid
  userName             String   @default("Admin") @map("user_name")
  oldRetailMarkup      Decimal  @map("old_retail_markup") @db.Decimal(5, 2)
  newRetailMarkup      Decimal  @map("new_retail_markup") @db.Decimal(5, 2)
  oldWholesaleMarkup   Decimal  @map("old_wholesale_markup") @db.Decimal(5, 2)
  newWholesaleMarkup   Decimal  @map("new_wholesale_markup") @db.Decimal(5, 2)
  oldAftermarketMarkup Decimal  @map("old_aftermarket_markup") @db.Decimal(5, 2)
  newAftermarketMarkup Decimal  @map("new_aftermarket_markup") @db.Decimal(5, 2)
  oldHourlyLaborRate   Decimal  @map("old_hourly_labor_rate") @db.Decimal(10, 2)
  newHourlyLaborRate   Decimal  @map("new_hourly_labor_rate") @db.Decimal(10, 2)
  reason               String?  @default("")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([changedBy])
  @@map("pricing_rules_audit_logs")
}

model MotorcycleModel {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  make           String
  model          String
  displacementCc Int              @map("displacement_cc")
  yearStart      Int              @map("year_start")
  yearEnd        Int?             @map("year_end")
  category       String
  imageUrl       String?          @map("image_url")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  fitments       ProductFitment[]

  @@unique([make, model, yearStart], map: "uq_motorcycle_models_make_model_year")
  @@index([make, model])
  @@map("motorcycle_models")
}

model ProductFitment {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String          @map("product_id") @db.Uuid
  modelId     String          @map("model_id") @db.Uuid
  fitmentType String          @map("fitment_type")
  yearRange   String?         @map("year_range")
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  model       MotorcycleModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([productId, modelId], map: "uq_product_fitments_product_model")
  @@index([modelId, fitmentType])
  @@index([productId])
  @@map("product_fitments")
}

model StaffShift {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId       String    @map("profile_id") @db.Uuid
  staffName       String    @map("staff_name")
  terminalId      String    @default("Terminal #01") @map("terminal_id")
  clockIn         DateTime  @default(now()) @map("clock_in") @db.Timestamptz(6)
  clockOut        DateTime? @map("clock_out") @db.Timestamptz(6)
  durationSeconds Int?      @default(0) @map("duration_seconds")
  status          String    @default("on_shift")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([profileId, clockIn(sort: Desc)])
  @@index([status, terminalId])
  @@map("staff_shifts")
}
